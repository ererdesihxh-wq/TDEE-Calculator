{
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "thetdeecalculator.net"
        }
      ],
      "destination": "https://www.thetdeecalculator.net/$1",
      "permanent": true
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
